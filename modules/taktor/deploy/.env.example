# Never commit real values. Copy to a protected deployment secret store.
OPENAI_API_KEY=
OPENAI_DIRECTOR_MODEL=
OPENAI_WORKER_MODEL=
OPENAI_JUDGE_MODEL=

ACESTEP_BASE_URL=http://acestep:8001
ACESTEP_API_KEY=replace-with-long-random-secret
